{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024", "DOM", "DOM.Iterable"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
