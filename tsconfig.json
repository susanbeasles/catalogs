{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext", "skipLibCheck": true,
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", ".generated/runtime.d.ts"]
}
