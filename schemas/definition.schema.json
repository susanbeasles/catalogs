{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/susanbeasles/catalogs/main/schemas/definition.schema.json",
  "title": "Catalog definition files",
  "$defs": {
    "index": { "type": "string", "minLength": 1, "description": "Main blurb, optionally Markdown. Start with a concise summary, then selection criteria, construction, and checks." },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "name", "aliases"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "description": "Must equal the containing folder name." },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "additionalInfo": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } }
  }
}
